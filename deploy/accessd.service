# accessd — 친구 가입 접수·승인 데몬. 설계 Docs/Design/2026-11-04-승인형가입설계.md 3-1
[Unit]
Description=AccessTool join daemon (accessd)
After=wg-quick@wg0.service accesstool-nft.service
BindsTo=wg-quick@wg0.service
Requires=accesstool-nft.service

[Service]
Type=simple
User=accesstool
Group=accesstool
ExecStart=/usr/local/sbin/accessd -config /etc/accesstool/accessd.conf
Restart=on-failure
RestartSec=5
UMask=0077

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# wg0.conf 파일 하나를 묶으면 그 inode 에 붙어 vim·sed -i 로 갈아 끼운 새 파일을 못 본다. 폴더는 root:accesstool 710 이라 새 파일은 못 만든다
ReadWritePaths=/etc/wireguard /var/lib/accesstool /run/wg-friend.lock

[Install]
WantedBy=multi-user.target wg-quick@wg0.service
